# MedicoAI configuration
# Copy this file to .env and adjust values as needed.
# The application reads these settings via os.environ.

# Flask secret key - required for session-based symptom tracking
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Confidence threshold (0-1) for accepting a recognized symptom
SYMPTOM_CONFIDENCE_THRESHOLD=0.5

# Maximum characters accepted in a single user message
MAX_MESSAGE_LENGTH=200

# Maximum number of symptoms tracked per conversation
MAX_SYMPTOMS_PER_SESSION=20

# Severity thresholds that trigger the "see a doctor" warning
SEVERITY_MEAN_THRESHOLD=4
SEVERITY_MAX_THRESHOLD=5
